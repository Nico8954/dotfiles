// ~/.config/zed/settings.json  (symlinked from ~/dotfiles/zed)
{
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha"
  },
  "icon_theme": "Catppuccin Mocha",
  "auto_install_extensions": {
    "catppuccin": true,
    "catppuccin-icons": true
  },
  "buffer_font_size": 14,
  "ui_font_size": 15,
  "terminal": {
    "shell": { "program": "/opt/homebrew/bin/fish" }
  },
  "telemetry": { "metrics": false, "diagnostics": false }
}
